<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+: allowBackup="false" stops cloud backup but not device-to-device
    transfer, which these rules are the only way to control. Nothing is
    carried across, for the reasons in backup_rules.xml: the identity cannot
    be decrypted on another phone, and every other thing here belongs to it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>

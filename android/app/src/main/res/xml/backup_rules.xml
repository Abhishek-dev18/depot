<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of a Depot is worth restoring elsewhere, and some of it is
    harmful to restore: the identity blob is encrypted with a keystore key
    that never leaves the phone, so a copy of it on another phone is
    unreadable, and the device list, folder grants and received files are
    all bound to this install. Backup is off in the manifest; these rules
    say the same for anything that honours them instead (API 30 and below).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

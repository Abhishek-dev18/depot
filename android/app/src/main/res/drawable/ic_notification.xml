<?xml version="1.0" encoding="utf-8"?>
<!--
  The same crate at notification size. Separate from the launcher
  foreground because a status-bar icon is masked to its alpha and tinted
  by the system: it needs to be a flat silhouette at 24dp, not a 108dp
  layer with a launcher's safe-zone padding around it.

  12dp across the 24dp canvas — corners at a radius of 8.5. Android does
  not formally mask these, but several systems draw them inside a circular
  badge, and the status bar shrinks them further still.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.0"
        android:pathData="M8.07,6.5 H15.93 A1.57,1.57 0 0 1 17.5,8.07 V15.93 A1.57,1.57 0 0 1 15.93,17.5 H8.07 A1.57,1.57 0 0 1 6.5,15.93 V8.07 A1.57,1.57 0 0 1 8.07,6.5 Z" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.0"
        android:pathData="M8.26,10.03 H15.74" />

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13.97,13.57 H16.33 V15.94 H13.97 Z" />
</vector>

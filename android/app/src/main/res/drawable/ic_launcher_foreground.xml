<?xml version="1.0" encoding="utf-8"?>
<!--
  The Depot crate, the same mark as web/public/favicon.svg: an amber
  outline, a seam across the top, and a block resting in the corner.

  That file is the reference for every copy of this mark — the favicon,
  the web nav, the Compose BrandMark and this launcher icon.

  Sized with room to spare rather than to the documented limit. Android
  guarantees the central 66dp of the 108dp canvas, and a square mark is
  constrained by its diagonal rather than its width, so 46dp is the widest
  square that theoretically fits. In practice launchers crop harder than
  that — this one is 40dp across, corners at a radius of 28 against the 33
  the circle allows, which leaves a fifth of the radius as margin.

  An icon that is slightly too small looks considered. One that is
  slightly too large looks broken.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFB020"
        android:strokeWidth="3.3"
        android:pathData="M40.9,35.65 H67.1 A5.25,5.25 0 0 1 72.35,40.9 V67.1 A5.25,5.25 0 0 1 67.1,72.35 H40.9 A5.25,5.25 0 0 1 35.65,67.1 V40.9 A5.25,5.25 0 0 1 40.9,35.65 Z" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFB020"
        android:strokeWidth="3.3"
        android:pathData="M41.5,47.4 H66.5" />

    <path
        android:fillColor="#FFB020"
        android:pathData="M60.6,59.2 H68.5 V67.1 H60.6 Z" />
</vector>

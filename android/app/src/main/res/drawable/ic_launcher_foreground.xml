<?xml version="1.0" encoding="utf-8"?>
<!--
  The Depot crate, the same mark as web/public/favicon.svg: an amber
  outline, a seam across the top, and a block resting in the corner.

  That file is the reference for every copy of this mark — the favicon,
  the web nav, the Compose BrandMark and this launcher icon.

  Sized to Android's safe zone, which is a 66dp circle in the middle of
  the 108dp canvas: a launcher may mask this to a circle, a squircle or a
  teardrop, and anything outside that circle can be cut. A square mark is
  constrained by its diagonal, not its width, so the widest square that
  fits is 66/sqrt(2) = 46dp. With the 3.75 stroke drawn centred on the
  path, the visual extent here is 45.75 — corners at a radius of 32.3,
  inside the 33 the circle allows.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFB020"
        android:strokeWidth="3.75"
        android:pathData="M39,33 H69 A6,6 0 0 1 75,39 V69 A6,6 0 0 1 69,75 H39 A6,6 0 0 1 33,69 V39 A6,6 0 0 1 39,33 Z" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFB020"
        android:strokeWidth="3.75"
        android:pathData="M39.75,46.5 H68.25" />

    <path
        android:fillColor="#FFB020"
        android:pathData="M61.5,60 H70.5 V69 H61.5 Z" />
</vector>

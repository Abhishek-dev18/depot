<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Light when the phone is light; values-night/themes.xml is the dark
      one. Compose draws everything after the first frame — this only
      decides what shows before it.
    -->
    <style name="Theme.Depot" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/depot_window</item>
    </style>
</resources>
